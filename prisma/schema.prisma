generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetType {
  CHECKING
  SAVINGS
  BROKERAGE
  RSU
  FOUR_O_ONE_K
  ROTH_IRA
  HSA
  CRYPTO
  HOME_VALUE
}

enum LiabilityType {
  MORTGAGE
  CAR_LOAN
  CREDIT_CARD
}

/// A login. Separate from Person: one household login can cover several people.
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Someone expenses are split between. Has no password and never signs in.
model Person {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  /// Hex from the curated palette in lib/colors.ts; drives this person's charts.
  color     String   @default("#2a78d6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountSplits     AccountSplit[]
  transactionSplits TransactionSplit[]
  income            Income[]
  netWorthBalances  NetWorthBalance[]
  monthlyIncome     MonthlyIncome[]
  companies         Company[]

  @@index([isActive])
}

/// Somewhere a person earns money. One person can hold several at once, so a
/// paycheck names the company it came from.
model Company {
  id            String          @id @default(cuid())
  name          String
  personId      String
  person        Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  monthlyIncome MonthlyIncome[]

  /// Two people may both work somewhere called "Meta"; one person may not.
  @@unique([personId, name])
  @@index([personId])
}

/// A person's paycheck detail for one month: what they earned gross and where
/// it went before it hit the bank. Net income is derived, never stored.
model MonthlyIncome {
  id             String   @id @default(cuid())
  month          DateTime @db.Date
  personId       String
  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Null for paychecks recorded before any company was set up.
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  annualSalary   Decimal  @default(0) @db.Decimal(12, 2)
  grossIncome    Decimal  @default(0) @db.Decimal(12, 2)
  medical        Decimal  @default(0) @db.Decimal(12, 2)
  dentalVision   Decimal  @default(0) @db.Decimal(12, 2)
  retirement401k Decimal  @default(0) @db.Decimal(12, 2)
  hsa            Decimal  @default(0) @db.Decimal(12, 2)
  taxes          Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// One paycheck per company per month — a second job is a second row.
  @@unique([month, personId, companyId])
  @@index([month])
  @@index([companyId])
}

model Account {
  id           String         @id @default(cuid())
  /// Must match the CSV export exactly; import relies on it.
  name         String         @unique
  /// Friendly label shown in tables and charts. Falls back to name.
  nickname     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  splits       AccountSplit[]
  transactions Transaction[]
}

/// Default ownership of an account. Percentages across one account sum to 100.
model AccountSplit {
  accountId String
  personId  String
  percent   Int
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  person    Person  @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([accountId, personId])
  @@index([personId])
}

model Category {
  id             String        @id @default(cuid())
  name           String        @unique
  excludedFromFi Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
}

model Tag {
  id           String           @id @default(cuid())
  name         String           @unique
  createdAt    DateTime         @default(now())
  transactions TransactionTag[]
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  description String
  notes       String?
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isManual    Boolean  @default(false)
  importHash  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Empty means "inherit the account's default split".
  splits TransactionSplit[]
  tags   TransactionTag[]

  @@index([date])
  @@index([accountId])
  @@index([categoryId])
}

model TransactionSplit {
  transactionId String
  personId      String
  percent       Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  person        Person      @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([transactionId, personId])
  @@index([personId])
}

model TransactionTag {
  transactionId String
  tagId         String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model Income {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  source      String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([personId])
}

model NetWorthSnapshot {
  id        String            @id @default(cuid())
  month     DateTime          @unique @db.Date
  notes     String?
  balances  NetWorthBalance[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model NetWorthBalance {
  id            String           @id @default(cuid())
  snapshotId    String
  snapshot      NetWorthSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  assetType     AssetType?
  liabilityType LiabilityType?
  amount        Decimal          @db.Decimal(14, 2)
  /// Whose account this is. Null means it belongs to the household jointly.
  personId      String?
  person        Person?          @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([snapshotId])
  @@index([personId])
}

model AppSettings {
  id             String  @id @default("default")
  withdrawalRate Decimal @default(0.04) @db.Decimal(5, 4)
}
